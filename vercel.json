{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/g/:id",
      "destination": "/api/group-page?id=:id"
    },
    {
      "source": "/chieunayuonggi",
      "destination": "/chieunayuonggi/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "buildCommand": "npm run build:vercel"
}
